<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the Home Screen widget, which reads the snapshot of the user's lists from here -->
	<!-- Push notifications. Xcode switches this to production when exporting for TestFlight and the App Store -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple, offered next to Google sign-in -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal links: Marquee links (/l, /u, /f, /i, /join) open in the app. iOS checks each domain's
	     /.well-known/apple-app-site-association (served by the backend). For a new domain, add a line like
	     <string>applinks:onmarquee.app</string> here and change ShareLinks.baseURL (Services/ShareLinks.swift) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:movie-list-backend-dgct.onrender.com</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.Theodor-Vasile.Movie-List</string>
	</array>
</dict>
</plist>
