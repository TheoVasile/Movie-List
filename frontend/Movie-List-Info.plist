<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.263609300559-cun073mb085m1ppuj49tko388c9fmi85</string>
			</array>
		</dict>
		<dict>
			<!-- cinelist://film/<TMDb id>, used by the Home Screen widgets to open a film -->
			<key>CFBundleURLName</key>
			<string>Theodor-Vasile.Movie-List.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cinelist</string>
			</array>
		</dict>
	</array>
	<!-- Lets Firebase deliver notification data and refresh its token in the background -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The backend on the Mac is plain http, which iOS only allows for local network addresses -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Daylight mode uses your approximate location to switch to the light theme at sunrise and the dark theme at sunset. It stays on this iPhone.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Movie List connects to its server on your local network to load and save your lists.</string>
	<key>GIDClientID</key>
	<string>263609300559-cun073mb085m1ppuj49tko388c9fmi85.apps.googleusercontent.com</string>
</dict>
</plist>
