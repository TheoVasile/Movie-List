<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The name under the icon on the Home Screen and in Settings (also INFOPLIST_KEY_CFBundleDisplayName).
	     CFBundleName stays PRODUCT_NAME: the generated value wins over this file, and iOS shows the display name. -->
	<key>CFBundleDisplayName</key>
	<string>Marquee</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.263609300559-cun073mb085m1ppuj49tko388c9fmi85</string>
			</array>
		</dict>
		<dict>
			<!-- Firebase's fallback when it verifies a phone number: a reCAPTCHA page that returns to the app -->
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-263609300559-ios-fc25c4a4f59ab3911a1c3a</string>
			</array>
		</dict>
		<dict>
			<!-- cinelist://film/<TMDb id>, used by the Home Screen widgets to open a film; marquee:// works the same -->
			<key>CFBundleURLName</key>
			<string>Theodor-Vasile.Movie-List.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cinelist</string>
				<string>marquee</string>
			</array>
		</dict>
	</array>
	<!-- Lets Firebase deliver notification data and refresh its token in the background -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSContactsUsageDescription</key>
	<string>Marquee checks which of your contacts are on Marquee so you can follow them. Emails and numbers are scrambled on your iPhone first and never stored.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The backend on the Mac is plain http, which iOS only allows for local network addresses -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Daylight mode uses your approximate location to switch to the light theme at sunrise and the dark theme at sunset. Theatre check-ins use it to notice when you leave a movie theatre, so Marquee can ask what you saw. Your location stays on this iPhone.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Theatre check-ins use your location in the background only to notice when you leave a movie theatre after a film, so Marquee can ask what you saw. Your location stays on this iPhone and is never sent anywhere.</string>
	<!-- Region monitoring needs precise location; asked for with requestTemporaryFullAccuracyAuthorization when only approximate is allowed -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>TheatreCheckIns</key>
		<string>Theatre check-ins need your precise location to tell when you're at a movie theatre. It stays on this iPhone.</string>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Marquee connects to its server on your local network to load and save your lists.</string>
	<!-- Firebase Analytics: no ad personalisation, no SKAdNetwork registration and no IDFV; collection itself is
	     turned on or off by Share Usage Analytics in Settings -->
	<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS</key>
	<false/>
	<key>GOOGLE_ANALYTICS_REGISTRATION_WITH_AD_NETWORK_ENABLED</key>
	<false/>
	<key>GOOGLE_ANALYTICS_IDFV_COLLECTION_ENABLED</key>
	<false/>
	<key>GIDClientID</key>
	<string>263609300559-cun073mb085m1ppuj49tko388c9fmi85.apps.googleusercontent.com</string>
</dict>
</plist>
